{
	"name": "object-dot-ts",
	"version": "0.0.2",
	"description": "A utility library for safely getting and setting nested object properties",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"type": "module",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"test": "vitest",
		"test:watch": "vitest --watch --ui",
		"test:coverage": "vitest run --coverage",
		"prepare": "npm run build",
		"prepublishOnly": "npm run test && npm run build",
		"format": "npx @biomejs/biome lint --write",
		"release": "release-it"
	},
	"keywords": [
		"object",
		"utility",
		"get",
		"set",
		"nested",
		"typescript",
		"javascript"
	],
	"author": "Dhruv Jain <dhruvjainpenny@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/maddhruv/object-dot-ts.git"
	},
	"bugs": {
		"url": "https://github.com/maddhruv/object-dot-ts/issues"
	},
	"homepage": "https://github.com/maddhruv/object-dot-ts#readme",
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@types/node": "^24.5.2",
		"@vitest/coverage-v8": "^3.2.4",
		"@vitest/ui": "^3.2.4",
		"release-it": "^19.0.5",
		"tsup": "^8.5.0",
		"typescript": "^5.3.3",
		"vitest": "^3.2.4"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"tsup": {
		"entry": [
			"src",
			"!src/__tests__/**/*.ts"
		],
		"split": true,
		"sourcemap": true,
		"clean": true,
		"dts": true,
		"format": "esm",
		"bundle": false
	},
	"dependencies": {
		"type-fest": "^5.0.1"
	},
	"release-it": {
		"$schema": "https://unpkg.com/release-it/schema/release-it.json",
		"github": {
			"release": true
		}
	}
}
